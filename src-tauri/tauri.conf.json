{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomo",
  "version": "1.0.0",
  "identifier": "app.pomo.timer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pomo",
        "width": 360,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "hopdaele",
    "copyright": "Copyright (c) 2026 hopdaele. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "A tiny, keyboard-first Pomodoro timer",
    "longDescription": "Pomo is a featherweight, keyboard-first Pomodoro timer for Windows with tray, global hotkeys, full-screen mode and a flat true-black gruvbox design.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
